{
  "name": "@docqa/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:integration": "MONGODB_TEST_URI=mongodb://localhost:27017/?directConnection=true vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint ."
  },
  "dependencies": {
    "bullmq": "^5.34.6",
    "ioredis": "^5.4.2",
    "minio": "^8.0.7",
    "mongodb": "^6.21.0",
    "unpdf": "^1.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.0.5",
    "pdf-lib": "^1.17.1"
  }
}
