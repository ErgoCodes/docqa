NODE_ENV=development

# MongoDB (mongodb-atlas-local via Docker Compose)
MONGODB_URI=mongodb://localhost:27017/docqa?directConnection=true

# Redis
REDIS_URL=redis://localhost:6379

# MinIO (almacenamiento de objetos compatible con S3)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme-local-only
MINIO_BUCKET=docqa-documents

# API
API_PORT=3000
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# Frontend (Vite solo expone al bundle las variables con prefijo VITE_)
VITE_API_URL=http://localhost:3000

# Worker
WORKER_CONCURRENCY=2
